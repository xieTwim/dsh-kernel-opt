{
  "name": "@xietwim/dsh-kernel-opt",
  "description": "Kernel-optimization plugin for DeepSeek Harness: live latency curve + run controls + kernel loop with wrap-up + optional second-model supervision (works with any bench tool)",
  "version": "0.16.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "preset",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --experimental-strip-types --test tests/projection.test.ts tests/loop.test.ts tests/chart.test.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.2 <0.2",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.2 <0.2",
    "@deepseek-ai/dsh-compaction": ">=0.1.0-rc.2 <0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.2 <0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.2 <0.2",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.2 <0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.2 <0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-presets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.2"
  }
}
